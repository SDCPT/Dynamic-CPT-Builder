msgstr ""
"Das Formular ist abgelaufen. Bitte lade die Seite neu und versuche es "
"erneut."

#: includes/class-submit.php:91
msgid "The form could not be verified. Please reload the page and try again."
msgstr ""
"Das Formular konnte nicht geprüft werden. Bitte lade die Seite neu und "
"versuche es erneut."

#: includes/class-submit.php:124
msgid "Please choose a valid category."
msgstr "Bitte wähle eine gültige Kategorie."

#: includes/class-submit.php:133
msgid "Please enter a name or title."
msgstr "Bitte gib einen Namen oder Titel ein."

#: includes/class-submit.php:138
msgid "Please enter a valid email address."
msgstr "Bitte gib eine gültige E-Mail-Adresse ein."

#: includes/class-submit.php:141
