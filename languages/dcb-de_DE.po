msgstr ""
"Zu viele Einreichungen von deiner Verbindung. Bitte versuche es später "
"erneut."

#: includes/class-submit.php:208
msgid "We cannot accept new entries right now. Please try again later."
msgstr ""
"Wir können gerade keine neuen Einträge annehmen. Bitte versuche es später "
"erneut."

#: includes/class-submit.php:222
msgid "The image could not be uploaded."
msgstr "Das Bild konnte nicht hochgeladen werden."

#: includes/class-submit.php:245
