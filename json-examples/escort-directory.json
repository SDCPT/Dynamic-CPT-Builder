{
    "title": {
        "label": "Name",
        "type": "text",
        "required": true,
        "is_title": true
    },
    "content": {
        "label": "Description",
        "type": "textarea",
        "required": false,
        "is_content": true
    },
    "phone": {
        "label": "Phone Number",
        "type": "tel",
        "required": true
    },
    "email": {
        "label": "Contact Email",
        "type": "email",
        "required": false
    },
    "age": {
        "label": "Age",
        "type": "number",
        "required": true
    },
    "location": {
        "label": "Location",
        "type": "text",
        "required": true,
        "placeholder": "e.g., Berlin"
    },
    "available_for": {
        "label": "Available For",
        "type": "select",
        "multiple": true,
        "required": true,
        "options": [
            { "value": "dinner", "label": "Dinner Dates" },
            { "value": "travel", "label": "Travel Companion" },
            { "value": "events", "label": "Events" },
            { "value": "private", "label": "Private Time" }
        ]
    },
    "languages": {
        "label": "Languages",
        "type": "select",
        "multiple": true,
        "required": false,
        "options": [
            { "value": "en", "label": "English" },
            { "value": "de", "label": "German" },
            { "value": "es", "label": "Spanish" },
            { "value": "fr", "label": "French" }
        ]
    },
    "availability": {
        "label": "Currently Available?",
        "type": "radio",
        "required": true,
        "options": [
            { "value": "yes", "label": "Yes" },
            { "value": "no", "label": "No" }
        ]
    }
}
