        "multiple": true,
        "options": [
            {
                "value": "php",
                "label": "PHP"
            },
            {
                "value": "js",
                "label": "JavaScript"
            },
            {
                "value": "py",
                "label": "Python"
            },
            {
                "value": "java",
                "label": "Java"
            },
            {
                "value": "cpp",
                "label": "C++"
            },
            {
                "value": "rust",
                "label": "Rust"
            }
        ],
        "required": true
    },
    "skills": {
        "label": "Frameworks",
        "type": "textarea"
    },
    "available": {
        "label": "Momentan verfügbar für neue Projekte?",
        "type": "checkbox",
        "options": [
            {
                "value": "1",
                "label": "Ja"
