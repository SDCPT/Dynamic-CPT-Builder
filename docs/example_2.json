{
    "title": {
        "label": "Name ",
        "type": "text",
        "required": true
    },
    "content": {
        "label": "Profil-Beschreibung",
        "type": "textarea",
        "required": false
    },
    "email": {
        "label": "Kontakt-E-Mail",
        "type": "email",
        "required": true
    },
    "phone": {
        "label": "Telefonnummer",
        "type": "tel",
        "required": false
    },
    "website": {
        "label": "Portfolio-URL",
        "type": "url",
        "required": false
    },
    "languages": {
        "label": "Programmiersprachen",
